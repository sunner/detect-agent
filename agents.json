{
  "$schema": "./agents.schema.json",
  "version": 1,
  "description": "Language-agnostic specification for detecting AI agents and automated development environments. Agents are evaluated in array order; the first agent whose `match` condition is satisfied wins. Every agent's `match` is a combinator (`anyOf`/`allOf`) whose `conditions` are evaluated as a tree: combinators nest, and `env_set`/`env_value`/`file_exists` are leaf checks. See agents.schema.json for the full structure.",
  "aiAgentVar": "AI_AGENT",
  "agents": [
    {
      "key": "CRUSH",
      "name": "crush",
      "description": "Crush execution context. Checked before inherited editor-terminal markers.",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "CRUSH" }]
      }
    },
    {
      "key": "HERMES",
      "name": "hermes-agent",
      "description": "Hermes execution context, identified by its session or harness marker.",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "HERMES_SESSION_ID" },
          { "type": "env_set", "name": "HERMES_AGENT" }
        ]
      }
    },
    {
      "key": "KILO_CODE",
      "name": "kilo-code",
      "description": "Kilo Code execution context.",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "KILOCODE_FEATURE" }]
      }
    },
    {
      "key": "TRAE",
      "name": "trae",
      "description": "Trae AI shell context.",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "TRAE_AI_SHELL_ID" }]
      }
    },
    {
      "key": "VTCODE",
      "name": "vtcode",
      "description": "VTCode execution context. Requires the documented marker value, not just a non-empty variable.",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_value", "name": "VTCODE", "value": "1" }]
      }
    },
    {
      "key": "WORKBUDDY",
      "name": "workbuddy",
      "description": "WorkBuddy application context from its exact product-name markers. Generic packaging and configuration variables are insufficient.",
      "match": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "env_value",
            "name": "WORKBUDDY_APPLICATION_NAME",
            "value": "WorkBuddy"
          },
          {
            "type": "env_value",
            "name": "WORKBUDDY_APP_NAME",
            "value": "WorkBuddy"
          }
        ]
      }
    },
    {
      "key": "GROK_BOT",
      "name": "grok-bot",
      "description": "Grok Bot local or reported cloud-shell context. The cloud branch requires CURSOR_AGENT plus both exact Sand flags; shared infrastructure markers do not prove an exclusive or immediate caller. This rule precedes Cursor compatibility markers and is separate from Grok Build.",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_value", "name": "SAND_AGENT", "value": "1" },
          {
            "type": "allOf",
            "conditions": [
              { "type": "env_set", "name": "CURSOR_AGENT" },
              { "type": "env_value", "name": "SAND_MANIFEST_V2", "value": "1" },
              {
                "type": "env_value",
                "name": "SAND_SUPERVISOR_ENABLED",
                "value": "1"
              }
            ]
          }
        ]
      }
    },
    {
      "key": "QWENWORK",
      "name": "qwenwork",
      "description": "QwenWork context from a non-empty product integration variable. Its value is not restricted; shared use by other products has not been established. Session, region, site, execution-mode and endpoint fields are insufficient.",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "QODER_WORK_INTEGRATION_PRODUCT" }
        ]
      }
    },
    {
      "key": "CUE",
      "name": "cue",
      "description": "Cue Linux desktop-worker context from a reported runtime marker. Other MANUS-prefixed configuration variables are insufficient.",
      "match": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "env_value",
            "name": "MANUS_LONG_DESKTOP_WORKER",
            "value": "1"
          }
        ]
      }
    },
    {
      "key": "MUSE",
      "name": "muse",
      "description": "Muse execution context from reported active-agent or tool-call markers. Other instance, session, tier or location metadata is insufficient.",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_value", "name": "JARVIS_IS_ASSIGNED", "value": "1" },
          { "type": "env_set", "name": "JARVIS_TOOL_CALL_ID" }
        ]
      }
    },
    {
      "key": "MANUS_STUDIO",
      "name": "manus-studio",
      "description": "ManusStudio addon-runtime descriptor context from user-reported ordinary-shell observations. Descriptor values were not supplied; matching requires a non-empty value.",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "MANUS_ADDON_RUNTIME_SPEC_PATH" },
          { "type": "env_set", "name": "MANUS_ADDON_RUNTIME_SPECS_REVISION" }
        ]
      }
    },
    {
      "key": "DOUBAO_OFFICE",
      "name": "doubao-office",
      "description": "Doubao Office context from a user-reported non-empty runtime agent-name variable. Message, application, proxy, credential and deployment metadata are insufficient.",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "DOUBAO_OFFICE_AGENT_NAME" }
        ]
      }
    },
    {
      "key": "CURSOR",
      "name": "cursor",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "CURSOR_TRACE_ID" }]
      }
    },
    {
      "key": "CURSOR_CLI",
      "name": "cursor-cli",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "CURSOR_AGENT" },
          {
            "type": "env_value",
            "name": "CURSOR_EXTENSION_HOST_ROLE",
            "value": "agent-exec"
          }
        ]
      }
    },
    {
      "key": "KIMI",
      "name": "kimi",
      "description": "Kimi Code plugin hooks. KIMI_CODE_HOME may be configured outside an active Kimi session, so detection uses the plugin-scoped KIMI_PLUGIN_ROOT marker.",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "KIMI_PLUGIN_ROOT" }]
      }
    },
    {
      "key": "GROK",
      "name": "grok",
      "description": "Grok Build terminal or plugin context. GROK_AGENT must equal 1 because the same variable also has selector uses. Evaluated before Claude Code compatibility markers.",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_value", "name": "GROK_AGENT", "value": "1" },
          { "type": "env_set", "name": "GROK_PLUGIN_ROOT" },
          { "type": "env_set", "name": "GROK_PLUGIN_DATA" }
        ]
      }
    },
    {
      "key": "GEMINI",
      "name": "gemini_cli",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "GEMINI_CLI" }]
      }
    },
    {
      "key": "CLINE",
      "name": "cline",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "CLINE_ACTIVE" }]
      }
    },
    {
      "key": "CODEX",
      "name": "codex_cli",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "CODEX_SANDBOX" },
          { "type": "env_set", "name": "CODEX_CI" },
          { "type": "env_set", "name": "CODEX_THREAD_ID" },
          { "type": "env_set", "name": "CODEX_SANDBOX_NETWORK_DISABLED" }
        ]
      }
    },
    {
      "key": "ANTIGRAVITY",
      "name": "antigravity",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "ANTIGRAVITY_AGENT" },
          { "type": "env_set", "name": "ANTIGRAVITY_CLI_ALIAS" }
        ]
      }
    },
    {
      "key": "AUGMENT_CLI",
      "name": "augment-cli",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "AUGMENT_AGENT" }]
      }
    },
    {
      "key": "OPENCODE",
      "name": "open_code",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "OPENCODE_CLIENT" },
          { "type": "env_set", "name": "OPENCODE" }
        ]
      }
    },
    {
      "key": "GOOSE",
      "name": "goose",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "GOOSE_PROVIDER" },
          { "type": "env_set", "name": "GOOSE_TERMINAL" }
        ]
      }
    },
    {
      "key": "JUNIE",
      "name": "junie",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "JUNIE_DATA" },
          { "type": "env_set", "name": "JUNIE_SHIM_PATH" }
        ]
      }
    },
    {
      "key": "PI",
      "name": "pi",
      "description": "Matches when the PATH contains a '.pi/agent' (or '.pi\\\\agent') segment.",
      "match": {
        "type": "anyOf",
        "conditions": [
          {
            "type": "env_matches",
            "name": "PATH",
            "pattern": "\\.pi[\\\\/]agent"
          }
        ]
      }
    },
    {
      "key": "COWORK",
      "name": "cowork",
      "description": "Claude Cowork. Evaluated before `claude_code` so the more specific COWORK marker wins. Requires CLAUDE_CODE_IS_COWORK plus a Claude Code marker.",
      "match": {
        "type": "allOf",
        "conditions": [
          { "type": "env_set", "name": "CLAUDE_CODE_IS_COWORK" },
          {
            "type": "anyOf",
            "conditions": [
              { "type": "env_set", "name": "CLAUDECODE" },
              { "type": "env_set", "name": "CLAUDE_CODE" }
            ]
          }
        ]
      }
    },
    {
      "key": "CLAUDE",
      "name": "claude_code",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "CLAUDECODE" },
          { "type": "env_set", "name": "CLAUDE_CODE" }
        ]
      }
    },
    {
      "key": "REPLIT",
      "name": "replit",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "REPL_ID" }]
      }
    },
    {
      "key": "GITHUB_COPILOT",
      "name": "github-copilot",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "COPILOT_MODEL" },
          { "type": "env_set", "name": "COPILOT_ALLOW_ALL" },
          { "type": "env_set", "name": "COPILOT_GITHUB_TOKEN" }
        ]
      }
    },
    {
      "key": "KIRO",
      "name": "kiro",
      "description": "AWS Kiro context from AGENT_CONTEXT_OUT, or the existing TERM_PROGRAM and no_tty heuristic. TERM_PROGRAM alone also occurs in human-operated IDE terminals.",
      "match": {
        "type": "anyOf",
        "conditions": [
          { "type": "env_set", "name": "AGENT_CONTEXT_OUT" },
          {
            "type": "allOf",
            "conditions": [
              {
                "type": "env_matches",
                "name": "TERM_PROGRAM",
                "pattern": "kiro"
              },
              { "type": "no_tty" }
            ]
          }
        ]
      }
    },
    {
      "key": "OPENCLAW",
      "name": "openclaw",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "OPENCLAW_SHELL" }]
      }
    },
    {
      "key": "DEVIN",
      "name": "devin",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "file_exists", "path": "/opt/.devin" }]
      }
    },
    {
      "key": "ZED",
      "name": "zed",
      "description": "Zed terminal environment, not proof of an agent invocation. Kept as a fallback after other supported contexts.",
      "match": {
        "type": "anyOf",
        "conditions": [{ "type": "env_set", "name": "ZED_TERM" }]
      }
    }
  ]
}
